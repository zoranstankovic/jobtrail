# Installed to /etc/systemd/system (docs/deployment.md §5.5).
[Unit]
Description=JobTrail backup: pg_dump, then restic to object storage
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/jobtrail/backup.sh
