# /etc/jobtrail/backup.env on the server: root-owned, mode 600
# (docs/deployment.md §5.4). Read by /opt/jobtrail/backup.sh.
RESTIC_REPOSITORY=s3:https://s3.<region>.io.cloud.ovh.net/<bucket>
RESTIC_PASSWORD_FILE=/etc/jobtrail/restic-password
# The jobtrail-server S3 user: may write, but not change versioning or the
# lifecycle rules (deploy/s3-server-policy.json).
AWS_ACCESS_KEY_ID=<access key of jobtrail-server>
AWS_SECRET_ACCESS_KEY=<secret key of jobtrail-server>
AWS_DEFAULT_REGION=<region>
HC_PING_URL=https://hc-ping.com/<check-uuid>
