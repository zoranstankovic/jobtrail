# Template for /opt/jobtrail/app.env on the server (docs/deployment.md).
# Copy it, then fill in APP_KEY, APP_URL and DB_PASSWORD. <tailnet> is your
# tailnet's DNS name, e.g. tail1a2b3c.ts.net. The real file never goes into
# git or an image, and a copy of it lives in your password manager.
APP_NAME=JobTrail
APP_ENV=production
# base64: followed by 32 random bytes: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_DEBUG=false
APP_URL=https://jobtrail.<tailnet>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logs go to the container's stderr: docker compose logs app
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=jobtrail
DB_USERNAME=jobtrail
# The same value as /opt/jobtrail/secrets/db_password: openssl rand -hex 32
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# The app is only reached over HTTPS (tailscale serve).
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
